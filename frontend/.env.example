# Frontend settings (Vite). Copy to .env; .env is not committed.
VITE_API_BASE_URL=/api
# The backend Vite forwards /api to.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# On-prem server only (docs/deployment.md):
# where counters bill while this server's backend is down
# VITE_FAILOVER_CLOUD_API_URL=https://dev.gpsoftware.in/api
# the name the billing PCs open this server by (comma list)
# VITE_ALLOWED_HOSTS=mainserver
