<IfModule mod_rewrite.c>
    RewriteEngine On

    # Retired HTTP deployment helpers and archives must never be executable/downloadable.
    RewriteRule ^(?:public/)?(?:unzip\.php|migrate\.php|cleanup_stray_app\.php|default\.php|deploy\.(?:zip|tar\.gz))$ - [F,L,NC]

    # Forward all other requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
