# Hostinger Premium compatible invoice OCR. No VPS, Docker or Python runtime required.
# Create a free OCR.space API key and set it in Hostinger hPanel environment/.env.
OCR_SPACE_API_KEY=replace-with-your-ocr-space-key
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_TIMEOUT=120
OCR_SPACE_CONNECT_TIMEOUT=10
