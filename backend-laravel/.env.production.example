APP_NAME=GPRETAIL
APP_ENV=production
# Was committed here as a real, working key -- moved to the same GitHub-secret
# injection pattern as OCR_SPACE_API_KEY (see deploy.yml). A deploy with this
# secret unset ships a blank APP_KEY, which fails closed rather than silently
# falling back to the exposed value.
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://dev.gpsoftware.in

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u597975289_Dev
DB_USERNAME=u597975289_Dev
# Was committed here as a real, working production password -- moved to the
# same GitHub-secret injection pattern as OCR_SPACE_API_KEY (see deploy.yml).
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=file
QUEUE_CONNECTION=database
SANCTUM_STATEFUL_DOMAINS=dev.gpsoftware.in

# OCR provider configuration. Inject the real value during deployment.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_TIMEOUT=120
OCR_SPACE_CONNECT_TIMEOUT=10

# Shared secret required to call GET/POST /backups/scheduled-run (external cron
# trigger for scheduled backups). Generate a real random value and set it on
# the production server - the endpoint fails closed (403) if this is unset.
BACKUP_CRON_SECRET=

# This deploy is the shared multi-tenant cloud install for the local-server /
# cloud-failover feature - explicit even though 'cloud' is already the default,
# so the local/cloud distinction is visible here. A store's own on-prem install
# sets SYNC_NODE_ROLE=local plus SYNC_CLOUD_API_BASE_URL pointing back at this
# deploy; those only belong in that store's local .env, not here.
SYNC_NODE_ROLE=cloud

# Gpretail_Admin (the platform/control-plane side of this deployment). Without this,
# PlatformClient falls back to its http://localhost:8000 default and every
# activation/platform:sync call fails to connect.
PLATFORM_BASE_URL=https://admin.gpsoftware.in

# Pusher (live dashboard push updates). app_id/key/cluster aren't secret -- key
# ships in the frontend bundle anyway -- only PUSHER_APP_SECRET is, so that one
# alone is injected from a GitHub secret during deploy (see deploy.yml).
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=2193726
PUSHER_APP_KEY=09ec1437c80a8afde725
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
