# Fallback for the stray "app" directory 403 (see the mod_rewrite block below for why it exists):
# neither the RewriteRule nor DirectorySlash Off stopped Apache's own directory-index handling
# from winning for the bare /app/ request. Catching the 403 itself and internally serving
# index.php instead is a blunter fix, but doesn't depend on out-precedence-ing that directory
# handling - and since this is a client-side-routed SPA, the browser's address bar still shows
# /app/ regardless of how the server internally produced the response, so React Router still
# renders the right route.
ErrorDocument 403 /index.php

# Hostinger's platform applies a blanket 7-day Cache-Control (public,
# max-age=604800) to static files regardless of what this app sends -
# harmless for Vite's content-hashed JS/CSS (a new deploy gets a new
# filename anyway), but fatal for the PWA service worker and manifest:
# browsers only ever re-check sw.js for updates when they can fetch a
# fresh copy, so with a week-long cache a phone that visited before a
# deploy keeps running the OLD service worker - and therefore the old
# cached app shell - for up to 7 days no matter how many times the
# backend gets redeployed. Force these specific files to always
# revalidate so PWA updates actually reach users after a deploy.
<IfModule mod_headers.c>
    <FilesMatch "^(sw|service-worker|registerSW)\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header unset Expires
    </FilesMatch>
    <FilesMatch "^manifest\.webmanifest$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # A real "app" directory exists on the server from an earlier deployment attempt
    # (a standalone static PWA build, since replaced by a client-side React route).
    # Apache's own directory-slash/index handling runs BEFORE mod_rewrite for a bare
    # request that matches an existing directory - that's what was 403ing /app/ even
    # with the RewriteRule below in place, since this directive intercepted the
    # request before the rule ever got evaluated. Turning it off hands every request
    # to mod_rewrite instead, so the RewriteRule below is what actually decides.
    DirectorySlash Off

    # The responsive PWA is a React route (/app/*), not a physical public directory.
    # Force these requests through Laravel/React even though a physical /app folder
    # still exists on the server (see DirectorySlash above for why that mattered).
    RewriteRule ^app(?:/.*)?/?$ index.php [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
